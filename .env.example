# Supabase authentication and progress synchronization.
# Find these in Supabase Project Settings > API.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY=""

# Optional HTTPS endpoint for the authenticated Quran Whisper service.
# The service must validate the Supabase access token and return { "text": "..." }.
VITE_QURAN_ASR_URL=""
VITE_QURAN_ASR_MODEL="quran-whisper"
